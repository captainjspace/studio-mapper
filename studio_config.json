{
  "devices": {
    "16a": "http://16a.local",
    "24ai": "http://24ai.local",
    "10pre": ""
  },
  "interfaces": {
    "Motu 16A": "16a",
    "Motu 24Ai": "24ai",
    "Motu 10pre": "10pre"
  },
  "host_device": "10pre",
  "host_inputs": [
    {
      "device": "16a",
      "bank": "Analog",
      "count": 16,
      "host_start": 1,
      "avb_stream": 1
    },
    {
      "device": "24ai",
      "bank": "Analog",
      "count": 24,
      "host_start": 17,
      "avb_stream": 3
    },
    {
      "device": "10pre",
      "bank": "Mic/Inst",
      "count": 10,
      "host_start": 41
    }
  ],
  "mix": {
    "drums": {
      "preset": "Bus/tequiladrumchannel.cst",
      "sends": [
        {
          "to": "Drum_Verb",
          "level": -12.0
        }
      ]
    },
    "Smashed_Guitars": {
      "sends": [
        {
          "to": "FX",
          "level": -6.0
        }
      ]
    },
    "joshgtr": {
      "pan": -64
    },
    "johngtr": {
      "pan": 63
    },
    "Punchy_Bass": {
      "preset": "Bus/PunchyWarmBass.cst"
    },
    "Screaming_Demons": {
      "sends": [
        {
          "to": "FX",
          "level": -12.0
        }
      ]
    },
    "Drum_Verb": {
      "kind": "aux",
      "plugin": "Quantec Room Simulator/StudioDrums.pst"
    },
    "FX": {
      "kind": "aux",
      "preset": "Processing/InsaneFXStack.cst"
    },
    "Mix_Bus": {
      "kind": "aux",
      "plugin": "I:O/UA2-1176.pst",
      "insert": {
        "rig": "home",
        "out": "3/4",
        "in": "13/14"
      }
    },
    "Stereo_Out": {
      "kind": "output",
      "preset": "Output/Mastering.cst"
    }
  },
  "stem_split": {
    "Drums": "drums",
    "Bass": "Punchy_Bass",
    "Guitar": "Smashed_Guitars",
    "Piano": "Synths",
    "Vocals": "Screaming_Demons",
    "Other": "Synths"

{
  "state_dir": "state",
  "preset_index": "data/presets.txt",
  "default_rig": "oakland",
  "rigs": {
    "oakland": {
      "sheet": "data/studio-inputs.csv",
      "host_device": "10pre",
      "devices": {
        "16a": "http://16a.local",
        "24ai": "http://24ai.local",
        "10pre": ""
      },
      "interfaces": {
        "Motu 16A": "16a",
        "Motu 24Ai": "24ai",
        "Motu 10pre": "10pre"
      },
      "host_inputs": [
        {
          "device": "16a",
          "bank": "Analog",
          "count": 16,
          "host_start": 1,
          "avb_stream": 1
        },
        {
          "device": "24ai",
          "bank": "Analog",
          "count": 24,
          "host_start": 17,
          "avb_stream": 3
        },
        {
          "device": "10pre",
          "bank": "Mic",
          "count": 10,
          "host_start": 41
        }
      ]
    },
    "home": {
      "sheet": "data/home-inputs.csv",
      "host_device": "UltraLite AVB",
      "devices": {
        "ultralite": "http://UltraLite-AVB.local"
      },
      "interfaces": {
        "Motu UltraLite AVB": "ultralite"
      },
      "host_inputs": [
        {
          "device": "ultralite",
          "bank": "Mic",
          "count": 2,
          "host_start": 1
        },
        {
          "device": "ultralite",
          "bank": "Analog",
          "from": 1,
          "count": 2,
          "host_start": 5
        },
        {
          "device": "ultralite",
          "bank": "Guitar",
          "count": 1,
          "host_start": 7
        },
        {
          "device": "ultralite",
          "bank": "Analog",
          "from": 5,
          "count": 2,
          "host_start": 9
        },
        {
          "device": "ultralite",
          "bank": "Analog",
          "from": 3,
          "count": 2,
          "host_start": 15
        }
      ],
      "outputs": {
        "ultralite": {
          "Analog 1": "1176_Send_L",
          "Analog 2": "1176_Send_R"
        }
      },
      "routes": {
        "ultralite": {
          "Analog 1": "Computer 5",
          "Analog 2": "Computer 6",
          "Computer 5": "Analog 1",
          "Computer 6": "Analog 2",
          "Computer 13": "Computer 3",
          "Computer 14": "Computer 4"
        }
      }
    }
  },
  "mix": {
    "drums": {
      "preset": "Bus/tequiladrumchannel.cst",
      "sends": [
        {
          "to": "Drum_Verb",
          "level": -12.0
        }
      ]
    },
    "Smashed_Guitars": {
      "sends": [
        {
          "to": "FX",
          "level": -6.0
        }
      ]
    },
    "joshgtr": {
      "pan": -64
    },
    "johngtr": {
      "pan": 63
    },
    "Punchy_Bass": {
      "preset": "Bus/PunchyWarmBass.cst"
    },
    "Screaming_Demons": {
      "sends": [
        {
          "to": "FX",
          "level": -12.0
        }
      ]
    },
    "Drum_Verb": {
      "kind": "aux",
      "plugin": "Quantec Room Simulator/StudioDrums.pst"
    },
    "FX": {
      "kind": "aux",
      "preset": "Processing/InsaneFXStack.cst"
    },
    "Mix_Bus": {
      "kind": "aux",
      "plugin": "UA 2-1176 (hardware, recorded back as a stereo track)",
      "insert": {
        "rig": "home",
        "out": "Logic stereo out 5/6 \u2192 Analog Out 1/2 \u2192 1176",
        "in": "Analog In 1/2 (jacks 5/6) \u2192 record in 5/6"
      }
    },
    "Stereo_Out": {
      "kind": "output",
      "preset": "Output/Mastering.cst"
    }
  },
  "stem_split": {
    "Drums": "drums",
    "Bass": "Punchy_Bass",
    "Guitar": "Smashed_Guitars",
    "Piano": "Synths",
    "Vocals": "Screaming_Demons",
    "Other": "Synths"
  }
}
